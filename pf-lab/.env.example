# pf-lab configuration reference
#
# Copy to .env, edit, and `set -a; . ./.env; set +a` before running the scripts.
# Nothing here is required: every script has a working default. This file exists so
# the site-specific values live in one place instead of inside the scripts.
#
# .env is gitignored. Do not commit a filled-in copy.

# ---- container / image -------------------------------------------------------
PF_IMAGE=pentesterflow:full
PF_NAME=pentesterflow
PF_STATE=$HOME/.pentesterflow-docker
PF_WORK=$PWD

# ---- API key -----------------------------------------------------------------
# Prefer the interactive path (`pf --key` or `pf --save-key`), which keeps the key
# out of shell history and out of `ps`. Set this only for non-interactive use.
# DEEPSEEK_API_KEY=sk-...

# ---- target scope (used by setup-run.sh and make-report.sh) -------------------
PF_TARGET_CIDR=198.51.100.0/24
PF_TARGET_IFACE=wlan0
PF_GATEWAY_IP=198.51.100.1
PF_LOCAL_IP=198.51.100.9
PF_OUT_OF_SCOPE="Docker bridges 172.16.0.0/12 and any public address"

# ---- run locations -----------------------------------------------------------
PF_STATE_ROOT=$HOME/.pentesterflow-docker
PF_RUNS_ROOT=$HOME/pf-runs

# ---- preflight (pf --start) --------------------------------------------------
# Refuse to start unless an interface actually holds an address in this network.
# This is the guard against a mid-engagement NetworkManager fallback rerouting
# probes onto an out-of-scope link. Leave unset to disable.
# PF_REQUIRE_SUBNET=198.51.100.0/24

# ---- delegation budget (pentesterflow:main only) -----------------------------
# Sub-agent step budget. Docker passes an unset -e var as "", and Number("") is 0,
# so pf forwards this only when it is set.
PF_DELEGATE_MAX_STEPS=30

# ---- watcher / monitor -------------------------------------------------------
WATCH_PANES=""
WATCH_RUNS=5
WATCH_MINUTES=30
INTERVAL=300
RUNS="1 2"

# ---- report builder ----------------------------------------------------------
TARGET_CIDR=$PF_TARGET_CIDR
TARGET_IFACE=$PF_TARGET_IFACE
INVENTORY=1
OUTDIR=$PWD/out
NAME=incident-report
WARNINGS=""

# ---- agent skills ------------------------------------------------------------
# Optional. The image's entrypoint refreshes its own built-in skills on every start,
# so mounting a local skills dir is only needed for the playbooks in ./skills/:
#   pf --start --skills "$PF_LAB_DIR/skills"
# Or set `"skills_dirs": ["/work/skills"]` in the run's config.json. Note that pf
# passes unrecognized flags through, so --skills reaches pentesterflow unchanged.
PF_LAB_DIR=$PWD

# ---- MCP servers ------------------------------------------------------------
# Optional and OFF by default. `npx` is installed in the image, so a server is a
# one-line addition to the run's config.json. See ../mcp/README.md first: an MCP
# server is a local process with your privileges, and `npx -y pkg@latest` refetches
# from the network on every session start.
#
# Consent is keyed on command+args+env, so editing any of them re-prompts.
# Example (uncomment to use): browser MCP, already available as `pf --start --browser`.
# PF_MCP_EXAMPLE='{"name":"browser","command":"npx","args":["-y","@browsermcp/mcp@latest"]}'
